<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ProfileFullNameFragment"
    android:padding="20dp">

    <LinearLayout
        android:id="@+id/progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/arrow_left"/>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:layout_marginStart="10dp"
            android:layout_gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:progress="50"
            app:trackThickness="10dp"
            app:trackCornerRadius="20dp"
            app:indicatorColor="@color/basic"/>

    </LinearLayout>


    <TextView
        android:layout_marginTop="20dp"
        android:id="@+id/whatyouname"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/progress"
        android:text="@string/your_relationship_goals"
        android:fontFamily="@font/clashdisplay_bold"
        android:textSize="35sp"
        android:textColor="@color/basic"/>

    <TextView
        android:id="@+id/craft"
        android:layout_marginTop="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/whatyouname"
        android:text="@string/select_the_type_of_relationship_you_re_seeking_on_datinghub_whether_it_s_love_friendship_or_something_in_between_the_choice_is_entirely_yours"
        android:fontFamily="@font/clashdisplay_medium"
        android:textSize="16sp"/>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/signIn"
        android:layout_below="@+id/craft"
        android:layout_marginTop="10dp"
        android:orientation="vertical">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RelativeLayout
                android:layout_weight="1"
                android:paddingTop="12dp"
                android:paddingStart="12dp"
                android:paddingBottom="12dp"
                android:background="@drawable/relationship_goals_selected"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <TextView
                    android:textSize="18sp"
                    android:id="@+id/dating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dating"
                    android:textColor="@color/white"
                    android:fontFamily="@font/clashdisplay_medium"/>


                <TextView
                    android:layout_marginTop="10dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/dating"
                    android:fontFamily="@font/clashdisplay_regular"
                    android:text="@string/seeking_love_and_meaningful_connections_nchoose_dating_for_genuine_relationships"
                    android:textColor="@color/white"
                    android:textSize="14sp" />


            </RelativeLayout>

            <ImageView
                android:layout_marginLeft="-15dp"
                android:layout_gravity="center"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_tick" />


        </LinearLayout>


        <LinearLayout
            android:layout_marginTop="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RelativeLayout
                android:layout_weight="1"
                android:paddingTop="12dp"
                android:paddingStart="12dp"
                android:paddingBottom="12dp"
                android:background="@drawable/relationship_goals_normal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <TextView
                    android:textSize="18sp"
                    android:id="@+id/friendship"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/friendship"
                    android:textColor="@color/black"
                    android:fontFamily="@font/clashdisplay_medium"/>


                <TextView
                    android:layout_marginTop="10dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/friendship"
                    android:fontFamily="@font/clashdisplay_regular"
                    android:text="@string/seeking_love_and_meaningful_connections_nchoose_dating_for_genuine_relationships"
                    android:textColor="@color/black"
                    android:textSize="14sp" />


            </RelativeLayout>

            <ImageView
                android:visibility="invisible"
                android:layout_marginLeft="-15dp"
                android:layout_gravity="center"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_tick" />


        </LinearLayout>

        <LinearLayout
            android:layout_marginTop="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RelativeLayout
                android:layout_weight="1"
                android:paddingTop="12dp"
                android:paddingStart="12dp"
                android:paddingBottom="12dp"
                android:background="@drawable/relationship_goals_normal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <TextView
                    android:textSize="18sp"
                    android:id="@+id/casual"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/casual"
                    android:textColor="@color/black"
                    android:fontFamily="@font/clashdisplay_medium"/>


                <TextView
                    android:layout_marginTop="10dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/casual"
                    android:fontFamily="@font/clashdisplay_regular"
                    android:text="@string/seeking_love_and_meaningful_connections_nchoose_dating_for_genuine_relationships"
                    android:textColor="@color/black"
                    android:textSize="14sp" />


            </RelativeLayout>

            <ImageView
                android:visibility="invisible"
                android:layout_marginLeft="-15dp"
                android:layout_gravity="center"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_tick" />


        </LinearLayout>

        <LinearLayout
            android:layout_marginTop="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RelativeLayout
                android:layout_weight="1"
                android:paddingTop="12dp"
                android:paddingStart="12dp"
                android:paddingBottom="12dp"
                android:background="@drawable/relationship_goals_normal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <TextView
                    android:textSize="18sp"
                    android:id="@+id/relationship"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/serious_relationship"
                    android:textColor="@color/black"
                    android:fontFamily="@font/clashdisplay_medium"/>


                <TextView
                    android:layout_marginTop="10dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/relationship"
                    android:fontFamily="@font/clashdisplay_regular"
                    android:text="@string/seeking_love_and_meaningful_connections_nchoose_dating_for_genuine_relationships"
                    android:textColor="@color/black"
                    android:textSize="14sp" />


            </RelativeLayout>

            <ImageView
                android:visibility="invisible"
                android:layout_marginLeft="-15dp"
                android:layout_gravity="center"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_tick" />


        </LinearLayout>

    </LinearLayout>



    <com.google.android.material.button.MaterialButton
        android:layout_alignParentBottom="true"
        android:id="@+id/signIn"
        android:layout_marginTop="10dp"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:textSize="18sp"
        android:text="@string/next"
        android:fontFamily="@font/clashdisplay_bold"
        android:backgroundTint="@color/basic"/>

</RelativeLayout>