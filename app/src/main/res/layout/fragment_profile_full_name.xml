<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ProfileFullNameFragment"
    android:padding="20dp">

    <LinearLayout
        android:id="@+id/progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/arrow_left"/>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:layout_marginStart="10dp"
            android:layout_gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:progress="20"
            app:trackThickness="10dp"
            app:trackCornerRadius="20dp"
            app:indicatorColor="@color/basic"/>

    </LinearLayout>


    <TextView
        android:layout_marginTop="20dp"
        android:id="@+id/whatyouname"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/progress"
        android:text="@string/what_your_full_name"
        android:fontFamily="@font/clashdisplay_bold"
        android:textSize="35sp"
        android:textColor="@color/basic"/>

    <TextView
        android:id="@+id/craft"
        android:layout_marginTop="20dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/whatyouname"
        android:text="@string/craft_a_distinctive_nickname_that_truly_reflects_your_identity_it_s_the_key_to_how_others_will_recognize_and_etch_you_in_their_memories"
        android:fontFamily="@font/clashdisplay_medium"
        android:textSize="16sp"/>


    <com.google.android.material.textfield.TextInputLayout
        android:layout_marginTop="20dp"
        style="@style/MyTextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/craft"
        android:background="@drawable/textbox"
        android:hint="@string/enter_your_name"
        android:textColorHint="@color/black">

        <com.google.android.material.textfield.TextInputEditText
            android:gravity="center"
            android:fontFamily="@font/clashdisplay_medium"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:inputType="textPersonName"
            android:textColor="@color/black" />

    </com.google.android.material.textfield.TextInputLayout>


    <com.google.android.material.button.MaterialButton
        android:layout_alignParentBottom="true"
        android:id="@+id/signIn"
        android:layout_marginTop="10dp"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:textSize="18sp"
        android:text="@string/next"
        android:fontFamily="@font/clashdisplay_bold"
        android:backgroundTint="@color/basic"/>

</RelativeLayout>